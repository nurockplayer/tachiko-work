+            &mut runtime,
+            "resident/0",
+            "plan",
+            vec![number_input(&expense, "10"), number_input(&reserve, "0")]
+        ),
+        "resident/1"
+    );
+    let plan = table(&mut runtime, "plan");
+    let row = &plan.rows[0];
+    update(
+        &mut runtime,
+        "resident/1",
+        &format!("{}.{reserve}", row.id),
+        &format!("[{}.expense] * 2", row.key),
+    );
+    runtime
