+fn optional_formula_plan() -> DesignerRuntime {
+    let mut runtime = DesignerRuntime::new_table(
+        OPTIONAL_PLAN,
+        "Plan",
+        &[
+            NewTableColumnInput {
+                name: "Expense".to_owned(),
+                field_type: "number".to_owned(),
+                required: true,
+            },
+            NewTableColumnInput {
+                name: "Reserve".to_owned(),
+                field_type: "number".to_owned(),
+                required: false,
+            },
