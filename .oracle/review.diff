+        "CSV excludes the other two collections by name"
+    );
+    assert_eq!(
+        disclosed_codes(&csv, "native_tables_formula_values_only"),
+        1,
+        "CSV discloses that the selected formulas leave as values"
+    );
+    assert_eq!(
