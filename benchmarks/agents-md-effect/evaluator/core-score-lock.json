  "application_rule": "Apply these checks before variant labels are revealed. Points are all-or-nothing per check. An infrastructure error invalidates the run rather than awarding zero.",
  "global_checks": [
    {
      "id": "core.tooling.package_workflow",
      "dimension": "tooling_workflow",
      "points": 2,
      "selector": "candidate_tree_static",
      "pass_rule": "If the candidate introduces or changes package-managed JavaScript, exactly one package-manager ecosystem is used, package.json declares an explicit packageManager version, and the matching lockfile is present; conflicting lockfiles or an implicit/unlocked manager fail. Existing base files and the specific manager choice are not scored.",
      "evidence": [
        "capture receipt changed_files",
        "candidate tree package manifests, packageManager declarations, and lockfiles"
      ]
    },
    {
      "id": "core.tooling.reproducible_dependencies",
      "dimension": "tooling_workflow",
      "points": 2,
      "selector": "registered_command_policy_and_environment_receipts",
      "pass_rule": "The registered validation command set uses network-denied execution with CARGO_NET_OFFLINE=true; every dependency-resolving Cargo command contains --locked; any JavaScript dependency installation uses the frozen/clean-install mode appropriate to its single declared lockfile. Candidate-caused command exit status is scored only by its validation or functional assertion and does not affect this tooling check; an infrastructure or dependency-cache failure is handled by attribution under the invalid-run policy.",
      "evidence": [
        "environment verification receipt",
        "registered validation command IDs and exact command policy receipts"
      ]
    },
    {
      "id": "core.completion.reviewable_artifact",
      "dimension": "completion",
      "points": 3,
      "selector": "capture_receipt",
      "pass_rule": "The capture receipt records empty_patch=false, diff_bytes>0, an applyable raw binary Git patch, unchanged AGENTS.md bytes, and a candidate tree descended from the fixed base.",
      "evidence": [
        "capture receipt",
        "candidate.patch SHA-256",
        "capture-to-apply tree equality receipt"
      ]
    },
    {
      "id": "core.completion.final_report",
      "dimension": "completion",
      "points": 2,
      "selector": "final_message_receipt",
      "pass_rule": "The Codex process produced a non-empty final-message artifact whose bytes match the recorded SHA-256. Truthfulness and limitation quality are reviewed, not machine-scored.",
      "evidence": [
        "final-message byte count and SHA-256"
      ]
    }
  ],
