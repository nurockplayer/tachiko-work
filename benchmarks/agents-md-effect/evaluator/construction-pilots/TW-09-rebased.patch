+fn oracle_document() -> Document {
+    let formula_ids = [
+        "structural",
+        "binding",
+        "cycle-a",
+        "cycle-b",
+        "dependent",
+        "zero",
+        "depends-zero",
+        "independent",
+    ];
+    let mut definitions: BTreeMap<_, _> = formula_ids
+        .into_iter()
+        .map(|id| (FieldId::from(id), field(id)))
