  "$defs": {
    "overlayIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "inode", "type", "owner_uid", "mode", "flags", "bytes", "sha256"],
      "properties": {
        "path": {"const": "AGENTS.md"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "type": {"const": "regular_file"},
        "owner_uid": {"type": "integer", "minimum": 0},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"experiment_phase": {"const": "construction_pilot"}}},
      "then": {"properties": {"arm": {"const": "construction"}}}
    },
    {
      "if": {"properties": {"experiment_phase": {"const": "baseline_a"}}},
      "then": {
        "properties": {
          "arm": {"const": "A"},
          "configuration": {
            "type": ["object", "null"],
            "properties": {"multi_agent": {"const": false}}
          },
          "registration": {
            "properties": {
              "pair_id": {"type": "null"},
              "variant_firewall_receipt_sha256": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"experiment_phase": {"const": "controlled_ab"}}},
      "then": {
        "properties": {
          "arm": {"enum": ["A", "B"]},
          "configuration": {
            "type": ["object", "null"],
            "properties": {"multi_agent": {"const": false}}
          },
          "registration": {
            "properties": {
              "pair_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "variant_firewall_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"experiment_phase": {"const": "ultra_optional"}}},
      "then": {"properties": {"arm": {"const": "Ultra"}}}
    },
    {
      "if": {"properties": {"valid_run": {"const": true}}, "required": ["valid_run"]},
      "then": {
        "properties": {
          "blinded_candidate_id": {"type": "string", "minLength": 8},
          "invalid_reason": {"type": "null"},
          "invalidation": {"type": "null"},
          "outcome": {"enum": ["hard_failure", "major_regression", "acceptable", "strong"]},
          "run_stage": {"const": "complete"},
          "timing": {
            "type": "object",
            "properties": {"process_group_extinct": {"const": true}}
          },
          "configuration": {"type": "object"},
          "inputs": {"type": "object"},
          "environment": {"type": "object"},
          "agent_process": {"type": "object"},
          "patch": {
            "type": "object",
            "properties": {"agents_unchanged": {"const": true}}
          },
          "validation": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": ["infrastructure_error", "oracle_adapter_required"]
                  }
                },
                "required": ["status"]
              }
            }
          },
          "scoring": {
            "type": "object",
            "properties": {
              "outcome": {"enum": ["hard_failure", "major_regression", "acceptable", "strong"]},
              "core_checks": {
                "type": "array",
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {"status": {"const": "infrastructure_error"}},
                    "required": ["status"]
                  }
                }
              },
              "contract_groups": {
                "type": "array",
                "not": {
                  "contains": {
                    "type": "object",
                    "anyOf": [
                      {
                        "properties": {
                          "status": {
                            "enum": ["infrastructure_error", "oracle_adapter_required"]
                          }
                        },
                        "required": ["status"]
                      },
                      {
                        "properties": {
                          "check_results": {
                            "type": "array",
                            "contains": {
                              "type": "object",
                              "properties": {
                                "status": {"const": "infrastructure_error"}
                              },
                              "required": ["status"]
                            }
                          }
                        },
                        "required": ["check_results"]
                      }
                    ]
                  }
                }
              }
            }
          },
          "blinded_review": {
            "type": "object",
            "properties": {"frozen_before_unblinding": {"const": true}}
          },
          "contamination_checks": {
            "type": "object",
            "properties": {
              "protected_content_exposed": {"const": false},
              "pair_discarded": {"const": false}
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "unblinded_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"valid_run": {"const": false}}, "required": ["valid_run"]},
      "then": {
        "properties": {
          "invalid_reason": {"type": "string", "minLength": 1},
          "invalidation": {"type": "object"},
          "outcome": {"const": "invalid_run"},
          "run_stage": {"enum": ["preflight", "base_control", "preparation", "agent_execution", "capture", "candidate_validation", "oracle", "review", "unblinding"]},
          "scoring": {"type": "null"},
          "blinded_review": {"type": "null"}
        }
      }
    }
  ]
}
