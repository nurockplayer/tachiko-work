          },
          "required": ["required", "adapter_sha256", "source_artifact_sha256", "evaluator_diff_sha256", "custodian_id", "integrity_reviewer_id", "integrity_review_sha256", "ground_truth_qualification_sha256", "negative_control_qualification_sha256", "behavior_implemented_by_adapter", "contract_unchanged", "note"]
        }
