# Canonical .roproj/v1 members are UTF-8 text with normative LF endings.
# Keep the mixed direct-JSON/package .ro extension unclassified here.
**/*.roproj/manifest.json text eol=lf diff
**/*.roproj/schemas.json text eol=lf diff
**/*.roproj/entities/*.jsonl text eol=lf diff
# Fixtures are compared byte for byte, so no checkout may convert them.
acceptance/** -text
docs/research/fixtures/** -text
