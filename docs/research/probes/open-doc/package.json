{
  "name": "tachiko-open-doc-research-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "report": "node report.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test report.test.ts",
    "test:projection": "node --test acceptance.test.mjs",
    "test:publication": "node --test publication.test.mjs"
  },
  "dependencies": {
    "@open-document/core": "0.6.0",
    "playwright": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1"
  }
}
